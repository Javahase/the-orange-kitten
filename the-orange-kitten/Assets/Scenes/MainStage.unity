      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 879850669860624744, guid: 8c674a4c14a69ed4db34a6efff8964aa, type: 3}
      propertyPath: statements.Array.data[2].hidden
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 879850669860624744, guid: 8c674a4c14a69ed4db34a6efff8964aa, type: 3}
