      objectReference: {fileID: 0}
    - target: {fileID: 2947872597884302531, guid: dc53a7f5cb86cfed29dddcfd7dac8242, type: 3}
      propertyPath: helpEntries.Array.data[1].answer
      value: 'The robot has underlying logic that helps it get to a result. An odd
        statement is a step that does lead to a correct dish. However, the method
        is completely unorthodox. '
      objectReference: {fileID: 0}
    - target: {fileID: 2947872597884302531, guid: dc53a7f5cb86cfed29dddcfd7dac8242, type: 3}
      propertyPath: helpEntries.Array.data[2].answer
